{
  "id": "minimal-zine-editorial",
  "name": "留白杂志风",
  "name_en": "Minimal Zine Editorial",
  "invocation_aliases": [
    "留白杂志风"
  ],
  "version": "1.0.0",
  "created_at": "2026-07-28",
  "updated_at": "2026-07-29",
  "route": "ai-image-generation",
  "secondary_routes": [
    "image-report",
    "ppt",
    "web-ppt-html"
  ],
  "asset_type": "NERO-native fused style preset",
  "status": "nero_native_adaptation",
  "rights_status": "MIT rule reference; upstream example images remain remote references only",
  "source": {
    "repository": "LiamGvchi/gc-minimal-zine-poster",
    "url": "https://github.com/LiamGvchi/gc-minimal-zine-poster",
    "license": "MIT",
    "reviewed_head": "4cb0396ad4e834019f753b37e1c4f415f5e02026",
    "last_reviewed_at": "2026-07-28",
    "copied_upstream_assets": false
  },
  "style_positioning": "quiet minimal paper-zine editorial with large negative space, one compact subject cluster, sparse deterministic typography, one high-chroma anchor, and scanned print defects",
  "token_references": [
    "color.surface.paper",
    "color.text.primary",
    "color.brand.primary",
    "color.brand.accent",
    "font.cn.body",
    "space.report.pagePadding"
  ],
  "formats": {
    "poster-3x5": {
      "width_px": 1080,
      "height_px": 1800,
      "use_for": "WeChat article cover or vertical editorial poster"
    },
    "social-4x5": {
      "width_px": 1080,
      "height_px": 1350,
      "use_for": "social feed card"
    },
    "social-1x1": {
      "width_px": 1080,
      "height_px": 1080,
      "use_for": "square social card or thumbnail"
    },
    "slide-16x9": {
      "width_px": 1920,
      "height_px": 1080,
      "use_for": "PPT or web-PPT cover and chapter visual"
    }
  },
  "geometry": {
    "negative_space_ratio": {
      "min": 0.7,
      "max": 0.9
    },
    "subject_cluster_ratio": {
      "min": 0.08,
      "max": 0.25
    },
    "color_anchor_canvas_share": {
      "min": 0.008,
      "max": 0.025
    },
    "color_anchor_cluster_share": {
      "min": 0.15,
      "max": 0.35
    }
  },
  "variation_engine": {
    "recent_recipe_window": 3,
    "layout": [
      "center-fragment",
      "lower-left-float",
      "upper-right-block",
      "dual-panel",
      "irregular-cutout",
      "type-led",
      "dot-orbit",
      "single-specimen"
    ],
    "anchor": [
      "faded-photo",
      "torn-clipping",
      "flat-silhouette",
      "solid-color-block",
      "printed-illustration",
      "object-specimen",
      "geometric-overlay",
      "texture-window"
    ],
    "typography": [
      "floating-fragments",
      "edge-pressed-phrase",
      "archive-microtext",
      "diagonal-words",
      "ghost-text",
      "letterpress-object",
      "text-in-block",
      "almost-textless"
    ],
    "texture": [
      "xerox",
      "risograph",
      "letterpress",
      "halftone",
      "film-grain",
      "scan-noise",
      "paper-mottling",
      "selective-motion-blur"
    ],
    "mood": [
      "quiet",
      "summer",
      "solitude",
      "childhood",
      "seaside",
      "afternoon",
      "night",
      "memory",
      "slight-surrealism"
    ]
  },
  "generation_control": {
    "max_automatic_regenerations": 1,
    "thumbnail_review_required": true,
    "retry_triggers": [
      "subject anchor is imperceptible at thumbnail scale",
      "high-chroma anchor is absent or washed out",
      "reserved exact-text safe zone is contaminated",
      "result becomes full-bleed, commercial, glossy, cinematic, 3D, neon, cute, or scrapbook-dense"
    ],
    "failure_status_after_retry": "visual_not_ready"
  },
  "prompt_compiler": {
    "paragraphs": [
      "canvas, paper, negative space, cluster geometry, location, safe zone",
      "one content-derived metaphor, anchor type, print treatment",
      "accent hue, material form, visual share, sparse type texture, reproduction defects",
      "flat scan mood, hard avoids, deterministic exact-text boundary"
    ],
    "exact_text_policy": "Exact titles, dates, names, figures, labels, logos, captions, source notes, and compliance wording stay outside the generated raster layer."
  },
  "template_contract": {
    "generator_route": "ai-image-generation",
    "preset": "minimal-zine-editorial",
    "preset_source": "templates/gpt-image-brief/presets/minimal-zine-editorial",
    "overlay_template": "templates/gpt-image-brief/presets/minimal-zine-editorial/overlay-template.html",
    "qa_manifest": "scripts/sample-minimal-zine-visual-qa-manifest.json"
  },
  "use_for": [
    "WeChat and essay covers",
    "research-report covers and dividers",
    "PPT and web-PPT chapter visuals",
    "quiet editorial social cards",
    "AI image style exploration with deterministic overlays"
  ],
  "avoid_for": [
    "evidence-dense report-card bodies",
    "dashboards, forms, tables, charts, banker appendices, or regulatory pages",
    "exact financial, source, or compliance text inside generated imagery",
    "direct public or client reuse of upstream example images",
    "parallel installation of the upstream Skill"
  ],
